function RecipeShowcaseSection() {
  const recipes = [
    {
      src: '/hero/ugc_avtaar_product_ad.mp4',
      category: 'Avatar Product',
      title: 'Quick UGC ads with AI avatars',
      description: 'Select an AI avatar, upload product image, provide a few basic inputs, click generate, and get a polished UGC-style product ad.',
      features: [
        'Affordable to premium quality lanes',
        'Product image + avatar + a few campaign basics',
        'Built for fast, repeatable ad output',
      ]
    },
    {
      src: '/videos/samples/anime_lofi_reel.mp4',
      category: 'Anime Lofi Reel',
      title: 'Beautiful anime reels without prompt complexity',
      description: 'Upload the anime character, choose the motion, vibe, and scenery, and RangManch builds the reel prompt for you automatically.',
      features: null,
      overlay: 'Upload character → choose motion, vibe, scene → generate reel',
    },
    {
      src: '/videos/samples/panda_dancing.mp4',
      category: 'Make Anything Dance',
      title: 'Turn any character into a viral reel',
      description: 'Upload one clear character image and one dance clip, and RangManch transfers the choreography into a playful vertical dance reel.',
      features: [
        'Choreography follows the uploaded dance reference',
        '9:16 social-first output by default',
        'Great for memes, mascots, anime edits, and pets',
      ],
      overlay: 'Character image + dance video = viral reel',
    }
  ];

  return (
    <motion.section
      className="space-y-8"
      initial={{ opacity: 0 }}
      whileInView={{ opacity: 1 }}
      viewport={{ once: true, margin: '-50px' }}
      transition={{ duration: 0.5 }}
    >
      <div className="max-w-3xl">
        <p className="text-[11px] font-semibold uppercase tracking-[0.22em]" style={{ color: `hsl(var(--color-primary))` }}>Guided recipes</p>
        <h2 className="mt-3 bg-gradient-to-r from-[hsl(var(--color-primary))] via-[hsl(var(--color-accent-pink))] to-[hsl(var(--color-primary))] bg-clip-text font-heading text-[2.1rem] font-extrabold tracking-tight text-transparent sm:text-[3rem] sm:leading-[1.04]">
          Three fast ways to see RangManch working for you.
        </h2>
      </div>

      <div className="masonry-grid">
        {recipes.map((recipe, index) => (
          <motion.article
            key={recipe.title}
            className="glass-card overflow-hidden rounded-[30px] w-full"
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.4, delay: index * 0.15 }}
          >
            <div className="grid gap-0 md:grid-cols-[0.95fr_1.05fr]">
              <div className="relative border-b md:border-b-0 md:border-r" style={{ borderColor: `hsl(var(--color-border) / 0.65)` }}>
                <LandingVideo
                  src={recipe.src}
                  poster={recipe.src}
                  className="aspect-[9/16] h-full w-full object-cover"
                />
                {recipe.overlay && (
                  <div className="absolute inset-x-3 bottom-3 rounded-[16px] border px-3 py-2 text-xs font-medium backdrop-blur" style={{ borderColor: `hsl(var(--color-border) / 0.12)`, background: `hsl(var(--color-surface) / 0.45)`, color: `hsl(var(--color-text))` }}>
                    {recipe.overlay}
                  </div>
                )}
              </div>
              <div className="p-5 sm:p-6">
                <p className="text-[11px] font-semibold uppercase tracking-[0.18em]" style={{ color: `hsl(var(--color-primary))` }}>{recipe.category}</p>
                <h3 className="mt-3 font-heading text-2xl font-extrabold tracking-tight" style={{ color: `hsl(var(--color-text))` }}>{recipe.title}</h3>
                <p className="mt-3 text-sm leading-7" style={{ color: `hsl(var(--color-muted))` }}>
                  {recipe.description}
                </p>
                {recipe.features && (
                  <div className="mt-5 space-y-2 text-sm" style={{ color: `hsl(var(--color-muted))` }}>
                    {recipe.features.map(feature => (
                      <div key={feature} className="flex items-start gap-2">
                        <Check className="mt-0.5 h-4 w-4" style={{ color: `hsl(var(--color-primary))` }} />
                        {feature}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </motion.article>
        ))}
      </div>
    </motion.section>
  );
}

