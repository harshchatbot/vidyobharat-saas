                style={{
                  border: isPopular
                    ? '1px solid hsl(45, 96%, 56% / 0.5)'
                    : '1px solid hsl(var(--color-border) / 0.9)',
                  background: isPopular
                    ? 'hsl(45, 96%, 56% / 0.06)'
