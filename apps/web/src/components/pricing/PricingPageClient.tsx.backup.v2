                    border: '1px solid hsl(var(--color-primary) / 0.4)',
                    color: 'hsl(var(--color-primary))',
                  }
                : {
                    border: '1px solid hsl(var(--color-border))',
                    color: 'hsl(var(--color-muted))',
                  }
