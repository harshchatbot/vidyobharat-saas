# Supabase
SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?sslmode=require
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKETS=rangmanch-assets

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Migration behavior
MIGRATION_TARGET=both
AUTH_IMPORT_MODE=reset
FIRESTORE_BATCH_SIZE=400
CONCURRENCY=8
VERIFY_SAMPLE_SIZE=5
LOG_LEVEL=info
OUTPUT_DIR=./output
