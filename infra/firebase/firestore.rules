rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownerFieldMatches() {
      return isSignedIn() && (
        request.resource.data.user_id == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    function existingOwnerFieldMatches() {
      return isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // Top-level source-of-truth collections used by the backend runtime.
    match /credit_wallets/{walletId} {
      allow read: if existingOwnerFieldMatches();
      allow create, update: if ownerFieldMatches();
    }

    match /credit_transactions/{transactionId} {
      allow read: if existingOwnerFieldMatches();
      allow create, update: if ownerFieldMatches();
    }

    match /credit_topup_orders/{orderId} {
      allow read: if existingOwnerFieldMatches();
      allow create, update: if ownerFieldMatches();
    }

    match /image_generations/{imageId} {
      allow read: if existingOwnerFieldMatches();
      allow create, update: if ownerFieldMatches();
    }

    match /videos/{videoId} {
      allow read: if existingOwnerFieldMatches();
      allow create, update: if ownerFieldMatches();
    }

    match /influencer_personas/{personaId} {
      allow read: if existingOwnerFieldMatches();
      allow create, update: if ownerFieldMatches();
    }

    match /influencer_scene_presets/{sceneId} {
      allow read: if existingOwnerFieldMatches();
      allow create, update: if ownerFieldMatches();
    }

    match /asset_tags/{tagId} {
      allow read: if existingOwnerFieldMatches();
      allow create, update: if ownerFieldMatches();
    }

    // Primary ownership rule for all user-scoped documents mirrored from the API.
    // Backend writes use the Admin SDK and bypass rules; these rules protect direct client access.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /private/{document=**} {
        allow read, write: if isOwner(userId);
      }

      match /creditTransactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      match /images/{imageId} {
        allow read, write: if isOwner(userId);
      }

      match /videos/{videoId} {
        allow read, write: if isOwner(userId);
      }

      match /personas/{personaId} {
        allow read, write: if isOwner(userId);

        match /scenes/{sceneId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /sceneLibrary/{sceneId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
